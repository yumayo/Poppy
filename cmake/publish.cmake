cmake_minimum_required(VERSION 3.20)

foreach(required OUTPUT_DIR LAUNCHER_FILE APP_FILE TERMINAL_HOST WEBVIEW2_DIR WEBVIEW2_LOADER AI_DIR)
  if(NOT DEFINED ${required} OR "${${required}}" STREQUAL "")
    message(FATAL_ERROR "${required} is required")
  endif()
endforeach()
foreach(input "${LAUNCHER_FILE}" "${APP_FILE}" "${TERMINAL_HOST}" "${WEBVIEW2_LOADER}"
    "${WEBVIEW2_DIR}/LICENSE.txt" "${WEBVIEW2_DIR}/NOTICE.txt" "${AI_DIR}/README.md")
  if(NOT EXISTS "${input}")
    message(FATAL_ERROR "Release input is missing: ${input}")
  endif()
endforeach()
if(DEFINED WSL_HELPER AND NOT "${WSL_HELPER}" STREQUAL "" AND NOT EXISTS "${WSL_HELPER}")
  message(FATAL_ERROR "Release input is missing: ${WSL_HELPER}")
endif()

file(MAKE_DIRECTORY "${OUTPUT_DIR}")
file(LOCK "${OUTPUT_DIR}/.publish.lock" GUARD PROCESS TIMEOUT 60)
set(launcher "${OUTPUT_DIR}/Poppy.exe")
set(abi_file "${OUTPUT_DIR}/launcher-abi.txt")
if(EXISTS "${abi_file}")
  file(READ "${abi_file}" abi)
  if(NOT abi STREQUAL "1\n")
    message(FATAL_ERROR "Unsupported launcher ABI in ${abi_file}; use a separate output directory.")
  endif()
elseif(EXISTS "${launcher}")
  message(FATAL_ERROR "Refusing to replace an existing Poppy.exe. Choose a new output directory for the launcher.")
endif()

# Finish a private snapshot before making it visible to launchers. Never modify
# a published directory: running versions still use their helper and WebView2.
string(RANDOM LENGTH 16 ALPHABET 0123456789abcdef nonce)
set(stage "${OUTPUT_DIR}/releases/.staging-${nonce}")
file(MAKE_DIRECTORY "${stage}")
configure_file("${APP_FILE}" "${stage}/PoppyApp.dll" COPYONLY)
configure_file("${TERMINAL_HOST}" "${stage}/PoppyTerminalHost.exe" COPYONLY)
configure_file("${WEBVIEW2_LOADER}" "${stage}/WebView2Loader.dll" COPYONLY)
configure_file("${WEBVIEW2_DIR}/LICENSE.txt" "${stage}/WebView2-LICENSE.txt" COPYONLY)
configure_file("${WEBVIEW2_DIR}/NOTICE.txt" "${stage}/WebView2-NOTICE.txt" COPYONLY)
file(COPY "${AI_DIR}/" DESTINATION "${stage}/ai"
  PATTERN "__pycache__" EXCLUDE PATTERN "*.pyc" EXCLUDE PATTERN "*.log" EXCLUDE)
if(DEFINED WSL_HELPER AND NOT "${WSL_HELPER}" STREQUAL "")
  configure_file("${WSL_HELPER}" "${stage}/wsl/poppy-wsl-helper" COPYONLY)
endif()

function(release_hash directory result)
  file(GLOB_RECURSE files LIST_DIRECTORIES FALSE RELATIVE "${directory}" "${directory}/*")
  list(SORT files)
  set(contents "poppy-launcher-v1\n")
  foreach(file IN LISTS files)
    file(SHA256 "${directory}/${file}" hash)
    string(APPEND contents "${file}\n${hash}\n")
  endforeach()
  string(SHA256 hash "${contents}")
  set(${result} "${hash}" PARENT_SCOPE)
endfunction()
release_hash("${stage}" release_id)
set(release "${OUTPUT_DIR}/releases/${release_id}")
if(EXISTS "${release}")
  release_hash("${release}" existing_id)
  file(REMOVE_RECURSE "${stage}")
  if(NOT existing_id STREQUAL release_id)
    message(FATAL_ERROR "Published release has been modified: ${release}. current.txt has not been changed.")
  endif()
else()
  file(RENAME "${stage}" "${release}")
endif()

# Install the launcher once. Even when its build output changes, subsequent
# application publishes must not write or replace the installed executable.
if(NOT EXISTS "${launcher}")
  configure_file("${LAUNCHER_FILE}" "${OUTPUT_DIR}/.Poppy-${nonce}.exe" COPYONLY)
  file(WRITE "${abi_file}" "1\n")
  file(RENAME "${OUTPUT_DIR}/.Poppy-${nonce}.exe" "${launcher}")
endif()
set(current "")
if(EXISTS "${OUTPUT_DIR}/current.txt")
  file(READ "${OUTPUT_DIR}/current.txt" current)
endif()
if(NOT current STREQUAL "${release_id}\n")
  file(WRITE "${OUTPUT_DIR}/.current-${nonce}.txt" "${release_id}\n")
  file(RENAME "${OUTPUT_DIR}/.current-${nonce}.txt" "${OUTPUT_DIR}/current.txt")
endif()
message(STATUS "Poppy release ${release_id}: ${launcher} (restart Poppy to use it)")
