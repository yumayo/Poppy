cmake_minimum_required(VERSION 3.20)
file(REMOVE_RECURSE "${TEST_ROOT}")
set(input "${TEST_ROOT}/input with spaces")
set(output "${TEST_ROOT}/live with spaces")
file(MAKE_DIRECTORY "${input}/webview" "${input}/ai/scripts")
file(WRITE "${input}/Poppy.exe" "launcher-v1")
file(WRITE "${input}/PoppyApp.dll" "app-v1")
file(WRITE "${input}/PoppyTerminalHost.exe" "terminal-host-v1")
file(WRITE "${input}/webview/WebView2Loader.dll" "loader-v1")
file(WRITE "${input}/webview/LICENSE.txt" "license")
file(WRITE "${input}/webview/NOTICE.txt" "notice")
file(WRITE "${input}/ai/README.md" "ai integration")
file(WRITE "${input}/ai/scripts/hook.py" "hook-v1")
file(WRITE "${input}/ai/scripts/__pycache__/hook.pyc" "cache")
file(WRITE "${input}/poppy-wsl-helper" "helper-v1")

function(publish destination expected_success)
  execute_process(COMMAND "${CMAKE_COMMAND}"
    "-DOUTPUT_DIR=${destination}" "-DLAUNCHER_FILE=${input}/Poppy.exe" "-DAPP_FILE=${input}/PoppyApp.dll"
    "-DTERMINAL_HOST=${input}/PoppyTerminalHost.exe"
    "-DWEBVIEW2_DIR=${input}/webview" "-DWEBVIEW2_LOADER=${input}/webview/WebView2Loader.dll"
    "-DAI_DIR=${input}/ai" "-DWSL_HELPER=${input}/poppy-wsl-helper"
    -P "${POPPY_SOURCE_DIR}/cmake/publish.cmake"
    RESULT_VARIABLE result OUTPUT_VARIABLE log ERROR_VARIABLE error)
  if(expected_success AND NOT result EQUAL 0)
    message(FATAL_ERROR "Publish failed: ${log}\n${error}")
  elseif(NOT expected_success AND result EQUAL 0)
    message(FATAL_ERROR "An invalid publish succeeded: ${log}")
  endif()
endfunction()
function(expect_file path expected)
  file(READ "${path}" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "Unexpected file content: ${path}")
  endif()
endfunction()
function(current_release result)
  file(READ "${output}/current.txt" id)
  string(STRIP "${id}" id)
  string(LENGTH "${id}" length)
  if(NOT length EQUAL 64 OR NOT id MATCHES "^[0-9a-f]+$")
    message(FATAL_ERROR "Invalid current.txt: ${id}")
  endif()
  set(${result} "${output}/releases/${id}" PARENT_SCOPE)
endfunction()

publish("${output}" TRUE)
current_release(first)
expect_file("${output}/Poppy.exe" "launcher-v1")
expect_file("${output}/launcher-abi.txt" "1\n")
expect_file("${first}/PoppyApp.dll" "app-v1")
expect_file("${first}/PoppyTerminalHost.exe" "terminal-host-v1")
expect_file("${first}/WebView2Loader.dll" "loader-v1")
expect_file("${first}/WebView2-LICENSE.txt" "license")
expect_file("${first}/WebView2-NOTICE.txt" "notice")
expect_file("${first}/wsl/poppy-wsl-helper" "helper-v1")
expect_file("${first}/ai/scripts/hook.py" "hook-v1")
if(EXISTS "${first}/ai/scripts/__pycache__")
  message(FATAL_ERROR "A development cache was published")
endif()
file(READ "${output}/current.txt" first_id)

# A changed launcher build must not touch the installed launcher.
file(WRITE "${input}/Poppy.exe" "a different launcher build")
file(TIMESTAMP "${output}/Poppy.exe" launcher_time "%s")
publish("${output}" TRUE)
expect_file("${output}/Poppy.exe" "launcher-v1")
expect_file("${output}/current.txt" "${first_id}")
file(TIMESTAMP "${output}/Poppy.exe" new_launcher_time "%s")
if(NOT launcher_time STREQUAL new_launcher_time)
  message(FATAL_ERROR "The installed launcher was touched")
endif()

# A new release switches the pointer only after every component is in place.
file(WRITE "${input}/PoppyApp.dll" "app-v2")
file(WRITE "${input}/poppy-wsl-helper" "helper-v2")
file(WRITE "${input}/webview/WebView2Loader.dll" "loader-v2")
file(WRITE "${input}/ai/scripts/hook.py" "hook-v2")
file(WRITE "${output}/releases/.staging-interrupted/PoppyApp.dll" "incomplete")
publish("${output}" TRUE)
current_release(second)
if(first STREQUAL second)
  message(FATAL_ERROR "A changed release did not switch current.txt")
endif()
expect_file("${output}/Poppy.exe" "launcher-v1")
expect_file("${second}/PoppyApp.dll" "app-v2")
expect_file("${second}/wsl/poppy-wsl-helper" "helper-v2")
expect_file("${second}/WebView2Loader.dll" "loader-v2")
expect_file("${second}/ai/scripts/hook.py" "hook-v2")
expect_file("${first}/PoppyApp.dll" "app-v1")
expect_file("${first}/wsl/poppy-wsl-helper" "helper-v1")
expect_file("${first}/WebView2Loader.dll" "loader-v1")
expect_file("${first}/ai/scripts/hook.py" "hook-v1")
file(READ "${output}/current.txt" second_id)

# Failed publication must preserve the previous working selection.
file(REMOVE "${input}/webview/NOTICE.txt")
publish("${output}" FALSE)
expect_file("${output}/current.txt" "${second_id}")
file(WRITE "${input}/webview/NOTICE.txt" "notice")

# Helper-only and integration-only updates also need a new release directory.
file(WRITE "${input}/poppy-wsl-helper" "helper-v3")
publish("${output}" TRUE)
current_release(third)
if(third STREQUAL second)
  message(FATAL_ERROR "A helper-only update did not switch releases")
endif()
expect_file("${third}/PoppyApp.dll" "app-v2")
expect_file("${second}/wsl/poppy-wsl-helper" "helper-v2")
file(WRITE "${input}/ai/scripts/hook.py" "hook-v3")
publish("${output}" TRUE)
current_release(fourth)
if(fourth STREQUAL third)
  message(FATAL_ERROR "An integration-only update did not switch releases")
endif()
expect_file("${fourth}/ai/scripts/hook.py" "hook-v3")
expect_file("${third}/ai/scripts/hook.py" "hook-v2")
file(WRITE "${input}/webview/WebView2Loader.dll" "loader-v3")
publish("${output}" TRUE)
current_release(fifth)
if(fifth STREQUAL fourth)
  message(FATAL_ERROR "A loader-only update did not switch releases")
endif()
expect_file("${fifth}/WebView2Loader.dll" "loader-v3")
expect_file("${fourth}/WebView2Loader.dll" "loader-v2")

# Terminal hosts belong to their immutable release and affect its hash.
file(WRITE "${input}/PoppyTerminalHost.exe" "terminal-host-v2")
publish("${output}" TRUE)
current_release(sixth)
if(sixth STREQUAL fifth)
  message(FATAL_ERROR "A terminal-host-only update did not switch releases")
endif()
expect_file("${sixth}/PoppyTerminalHost.exe" "terminal-host-v2")
expect_file("${fifth}/PoppyTerminalHost.exe" "terminal-host-v1")
file(READ "${output}/current.txt" complete_id)
file(REMOVE "${input}/PoppyTerminalHost.exe")
publish("${output}" FALSE)
expect_file("${output}/current.txt" "${complete_id}")
file(WRITE "${input}/PoppyTerminalHost.exe" "terminal-host-v1")

# Reusing a damaged content-addressed release must fail without selecting it.
file(READ "${output}/current.txt" last_id)
file(WRITE "${second}/PoppyApp.dll" "damaged")
file(WRITE "${input}/poppy-wsl-helper" "helper-v2")
file(WRITE "${input}/webview/WebView2Loader.dll" "loader-v2")
file(WRITE "${input}/ai/scripts/hook.py" "hook-v2")
publish("${output}" FALSE)
expect_file("${output}/current.txt" "${last_id}")
expect_file("${output}/Poppy.exe" "launcher-v1")

# Never silently treat an old monolithic EXE as an installed launcher.
set(legacy "${TEST_ROOT}/legacy")
file(WRITE "${legacy}/Poppy.exe" "existing monolithic application")
publish("${legacy}" FALSE)
expect_file("${legacy}/Poppy.exe" "existing monolithic application")
if(EXISTS "${legacy}/current.txt")
  message(FATAL_ERROR "A legacy installation was partially migrated")
endif()
message(STATUS "Release publishing tests passed")
