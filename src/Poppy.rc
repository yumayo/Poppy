#include <winver.h>
#include "resource_ids.h"

IDI_POPPY ICON "Poppy.ico"

#ifndef POPPY_APP_DLL
1 24 "Poppy.manifest"
#endif

1 VERSIONINFO
FILEVERSION 0,1,0,0
PRODUCTVERSION 0,1,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
#ifdef POPPY_APP_DLL
FILETYPE VFT_DLL
#else
FILETYPE VFT_APP
#endif
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "Poppy\0"
            VALUE "FileVersion", "0.1.0.0\0"
#ifdef POPPY_APP_DLL
            VALUE "InternalName", "PoppyApp\0"
            VALUE "OriginalFilename", "PoppyApp.dll\0"
#else
            VALUE "InternalName", "Poppy\0"
            VALUE "OriginalFilename", "Poppy.exe\0"
#endif
            VALUE "ProductName", "Poppy\0"
            VALUE "ProductVersion", "0.1.0.0\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
